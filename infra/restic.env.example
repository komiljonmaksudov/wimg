# Copy to /etc/wimg/restic.env on the VPS, chmod 600, chown wimg:wimg.
# Generate RESTIC_PASSWORD with: openssl rand -base64 32
# Store RESTIC_PASSWORD in your password manager — without it, backups can't be restored.

RESTIC_REPOSITORY=s3:https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com/wimg-backup
RESTIC_PASSWORD=<long-random-passphrase-stored-in-password-manager>

# R2 API token with Object Read+Write scope, restricted to the wimg-backup bucket
AWS_ACCESS_KEY_ID=<r2-access-key-id>
AWS_SECRET_ACCESS_KEY=<r2-secret-access-key>

# R2 doesn't use regions but the AWS SDK requires the var. "auto" is the conventional value.
AWS_DEFAULT_REGION=auto
