# OPTIONAL — nice-to-have, deliberately not set up.
#
# There is currently NO backup of /var/lib/wimg/sync.db. If the VPS dies, the
# server-side copy goes with it. That's a considered trade, not an oversight:
# sync is a *relay*, not the system of record. Every device holds a full local
# SQLite, so a lost sync.db costs you the relay, not your data — re-link a
# device and it repopulates. Worth revisiting if wimg ever gets users beyond
# one person, where "just re-push from a device" stops being a real answer.
#
# The wimg-restic.{service,timer} units are installed by deploy.sh but are NOT
# enabled, so nothing runs until you deliberately turn them on.
#
# To enable, when you want it:
#   1. Pick a repository (see below) and fill this file in.
#   2. Install prerequisites — neither is on the box today:
#        apt-get install -y restic sqlite3
#      (the unit shells out to sqlite3 for a consistent .backup snapshot, and
#      expects restic at /usr/local/bin/restic — adjust ExecStart if apt puts
#      it at /usr/bin/restic).
#   3. cp this file to /etc/wimg/restic.env
#      chmod 600 /etc/wimg/restic.env && chown root:wimg /etc/wimg/restic.env
#   4. sudo -u wimg restic init          # one-time
#   5. systemctl enable --now wimg-restic.timer
#
# Generate RESTIC_PASSWORD with: openssl rand -base64 32
# Store RESTIC_PASSWORD in your password manager — without it, backups CANNOT
# be restored. The password is not recoverable from the repository.

# --- Repository: pick one -----------------------------------------------
# Hetzner Storage Box (~€3.80/mo for 1TB) — same provider as the VPS, restic
# speaks SFTP natively, no S3 credentials needed. Add the box's SSH key to the
# Storage Box first so the `wimg` user can authenticate non-interactively.
RESTIC_REPOSITORY=sftp:u123456@u123456.your-storagebox.de:/wimg-backup

# Alternative — Backblaze B2, if you'd rather not add a Hetzner subscription:
#   RESTIC_REPOSITORY=b2:wimg-backup:/
#   B2_ACCOUNT_ID=<key-id>
#   B2_ACCOUNT_KEY=<application-key>
#
# Cloudflare R2 was the original target here. Dropped as part of moving wimg
# off Cloudflare entirely — kept out of this file so it doesn't creep back in.

RESTIC_PASSWORD=<long-random-passphrase-stored-in-password-manager>
