# wimg landing page (static) — a *fragment*, installed to
# /etc/caddy/conf.d/wimg-web.caddy and pulled in by `import conf.d/*.caddy`.
# Never replaces the main /etc/caddy/Caddyfile; see wimg-sync.caddy for why.
#
# Built by `python3 wimg-site/build.py` into wimg-site/public/ and uploaded to
# /var/www/wimg by infra/scripts/deploy-web.sh. The old SvelteKit web app is
# gone; unknown paths (old app routes, bookmarks) get the landing page.
#
# No `log` block on purpose: the privacy page promises that this site keeps
# no access logs. Add one and that page has to change.

wimg.komiljonmaksudov.com {
	root * /var/www/wimg
	encode zstd gzip

	header {
		# app.js renders the page from templates with `new Function`, hence
		# 'unsafe-eval'. Inline styles come from the design export.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}

	# Pages and the app bundle revalidate so a deploy shows up immediately.
	header /fonts/* Cache-Control "public, max-age=2592000"
	header /img/* Cache-Control "public, max-age=86400"
	@revalidate path / /index.html /app.js /datenschutz.html
	header @revalidate Cache-Control "no-cache"
	# Kill switch for the old web app's service worker; must never be cached.
	header /service-worker.js Cache-Control "no-store"

	try_files {path} {path}.html /index.html
	file_server
}
