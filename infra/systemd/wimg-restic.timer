[Unit]
Description=Run wimg restic backup daily at 03:00 Europe/Berlin
Documentation=https://restic.readthedocs.io

[Timer]
# 03:00 daily, server time. Set timezone via `timedatectl set-timezone Europe/Berlin`.
OnCalendar=*-*-* 03:00:00
# If the system was off at 03:00, run on next boot
Persistent=true
# Add up to 5 minutes of jitter to avoid hammering R2 at exactly 03:00:00
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
