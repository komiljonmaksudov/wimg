<?xml version="1.0" encoding="utf-8"?>
<!--
  wimg launcher foreground — the same thin "W" as the web icon
  (wimg-web/static/icon-512.png) and the iOS AppIcon.

  Drawn in the 108x108dp adaptive-icon viewport. The art sits inside the
  central 72x72 safe zone so no launcher mask (circle, squircle, teardrop)
  clips it: every vertex is <30dp from the centre, well inside the 36dp
  radius of the tightest circular mask.

  Stroked rather than filled so the W keeps its hairline look at small
  sizes; miter joins give the sharp points at the two bottom vertices.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M32,35 L43,73 L54,47 L65,73 L76,35"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter"
        android:strokeMiterLimit="10" />
</vector>
